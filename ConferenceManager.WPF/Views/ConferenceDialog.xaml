<Window x:Class="ConferenceManager.WPF.Views.ConferenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ConferenceManager.WPF.Views"
        mc:Ignorable="d"
        Title="Conférence" Height="450" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Titre" Grid.Row="0" Margin="0,0,0,5"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="1" Margin="0,0,0,10"/>

        <TextBlock Text="Description" Grid.Row="2" Margin="0,0,0,5"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Lieu" Grid.Row="0" Grid.Column="0" Margin="0,0,0,5"/>
            <TextBox x:Name="LocationTextBox" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0"/>

            <TextBlock Text="Date" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"/>
            <DatePicker x:Name="DatePicker" Grid.Row="1" Grid.Column="1"/>
        </Grid>

        <TextBlock Text="Statut" Grid.Row="5" Margin="0,10,0,5"/>
        <ComboBox x:Name="StatusComboBox" Grid.Row="6" Margin="0,0,0,20">
            <ComboBoxItem Content="Planifié"/>
            <ComboBoxItem Content="En cours"/>
            <ComboBoxItem Content="Terminé"/>
            <ComboBoxItem Content="Annulé"/>
        </ComboBox>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Enregistrer" Click="Save_Click" Width="100" Margin="0,0,10,0"/>
            <Button Content="Annuler" Click="Cancel_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window> 