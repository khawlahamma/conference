<UserControl x:Class="ConferenceManager.WPF.Views.SpeakersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBox Width="200" Margin="0,0,10,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Ajouter" Command="{Binding AddSpeakerCommand}" Margin="0,0,10,0"/>
            <Button Content="Supprimer" Command="{Binding DeleteSpeakerCommand}"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker}" AutoGenerateColumns="True"/>
    </Grid>
</UserControl> 