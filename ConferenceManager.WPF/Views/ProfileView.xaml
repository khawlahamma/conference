<UserControl x:Class="ConferenceManager.WPF.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Profil utilisateur" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock Text="Nom :" FontWeight="Bold"/>
            <TextBlock Text="{Binding User.FullName}"/>
            <TextBlock Text="Email :" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding User.Email}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl> 