<Window x:Class="ConferenceManager.WPF.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="300" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Change Password" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Password Fields -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Current Password:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="CurrentPasswordBox" Margin="0,0,0,15"/>

            <TextBlock Text="New Password:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,15"/>

            <TextBlock Text="Confirm New Password:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,15"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Cancel" 
                    Click="CancelButton_Click" 
                    Width="80" 
                    Margin="0,0,10,0"/>
            <Button Content="Change Password" 
                    Click="ChangePasswordButton_Click" 
                    Width="120"/>
        </StackPanel>
    </Grid>
</Window> 