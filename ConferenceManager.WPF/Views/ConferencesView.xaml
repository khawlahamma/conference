<UserControl x:Class="ConferenceManager.WPF.Views.ConferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ConferenceManager.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Ajouter" Click="AddConference_Click" Margin="0,0,10,0"/>
            <Button Content="Modifier" Click="EditConference_Click" Margin="0,0,10,0"/>
            <Button Content="Supprimer" Click="DeleteConference_Click" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchBox" Width="200" Margin="10,0" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="StatusFilter" Width="150" SelectionChanged="StatusFilter_SelectionChanged">
                <ComboBoxItem Content="Tous"/>
                <ComboBoxItem Content="Planifiée"/>
                <ComboBoxItem Content="En cours"/>
                <ComboBoxItem Content="Terminée"/>
                <ComboBoxItem Content="Annulée"/>
            </ComboBox>
        </StackPanel>

        <ListView x:Name="ConferencesList" Grid.Row="1" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Titre" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}"/>
                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date, StringFormat=d}"/>
                    <GridViewColumn Header="Lieu" DisplayMemberBinding="{Binding Location}"/>
                    <GridViewColumn Header="Statut" DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl> 